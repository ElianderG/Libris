APP_NAME="Libris te liberant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Senhas do MySQL do Docker Compose. Preencha no .env. O container da aplicação conecta no host "mysql".
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Porta da aplicação no computador. 8080 evita conflito com o php artisan serve local.
APP_PORT=8080

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Login com Google. O redirect precisa ser o mesmo cadastrado no console do Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Juntos Se Faz, sandbox. A base é a da documentação oficial. O token não entra no repositório.
JUNTOS_SE_FAZ_BASE_URL=https://www.juntosefaz.com.br/gateway/api/v1
JUNTOS_SE_FAZ_TOKEN=
JUNTOS_SE_FAZ_WEBHOOK_SECRET=

# Pagsmile, sandbox. A base é a da documentação oficial. app_id e security_key não entram no repositório.
PAGSMILE_BASE_URL=https://gateway-test.pagsmile.com
PAGSMILE_APP_ID=
PAGSMILE_SECURITY_KEY=

AFFILIATE_COMMISSION_PERCENT=10
AFFILIATE_COOKIE_DAYS=7

# Administrador local. O seeder só cria a conta se as duas variáveis tiverem valor.
ADMIN_EMAIL=
ADMIN_PASSWORD=
